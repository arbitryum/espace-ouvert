<%= t(".greeting") %>

<%= t(".intro.#{@request.kind}", organization: @request.organization_name) %>

<% if @account_url %>
<%= t(".account", organization: @request.organization_name, url: @account_url) %>
<% else %>
<% hosting_request_details(@request).each do |label, value| %>
<%= label %> : <%= value %>
<% end %>

<%= t(".reply") %>
<% end %>

<%= t(".closing") %>
