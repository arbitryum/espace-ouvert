<p><%= t(".greeting") %></p>
<p><%= t(".intro.#{@request.kind}", organization: @request.organization_name) %></p>
<%# An account answers from its requests page; otherwise the details are here. %>
<% if @account_url %>
  <p><%= t(".account_html", organization: @request.organization_name, link: link_to(t(".account_link"), @account_url)) %></p>
<% else %>
  <ul>
    <% hosting_request_details(@request).each do |label, value| %>
      <li><strong><%= label %> :</strong> <%= simple_format value, {}, wrapper_tag: "span" %></li>
    <% end %>
  </ul>
  <p><%= t(".reply") %></p>
<% end %>
<p><%= t(".closing") %></p>
