<% content_for :title, @space.name %>
<% care_home = @space.care_home %>
<% details = care_home.address_details %>
<% address_label = details&.concise_label.presence || care_home.address %>
<% pin_icon = capture do %>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
  </svg>
<% end %>

<div class="max-w-4xl mx-auto mb-8">
  <%= render "carousel", images: @images, size: :large %>
</div>

<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <nav class="text-sm breadcrumbs mb-4">
      <ul>
        <li><%= link_to t(".all_spaces"), spaces_path %></li>
        <li><%= link_to care_home.name, care_home %></li>
        <li><%= @space.name %></li>
      </ul>
    </nav>

    <h1 class="text-4xl font-bold mb-2"><%= @space.name %></h1>
    <p class="text-xl text-base-content/70 mb-4"><%= care_home.name %></p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
    <div class="lg:col-span-2">
      <div class="card bg-base-100 shadow-md mb-6">
        <div class="card-body">
          <h2 class="card-title text-2xl mb-4"><%= t(".about") %></h2>
          <div class="text-base leading-relaxed whitespace-pre-wrap mb-8"><%= @space.description %></div>

          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-lg mb-1"><%= t(".availability") %></h3>
              <% slots = @space.recurring_availabilities.select(&:active?) %>
              <% if slots.any? %>
                <div class="overflow-x-auto">
                  <table class="table table-sm w-full">
                    <thead><tr><th><%= t(".day") %></th><th><%= t(".hours") %></th></tr></thead>
                    <tbody>
                      <%# One row per day, with each of its ranges on a line. %>
                      <% slots.group_by(&:weekday).each do |weekday, day_slots| %>
                        <tr>
                          <td class="align-top"><%= RecurringAvailability.weekday_name(weekday) %></td>
                          <td><% day_slots.each do |slot| %><span class="block"><%= slot.time_range %></span><% end %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
              <%# The free text is where the slots came from: shown only without them. %>
              <% if slots.empty? && @space.availability.present? %>
                <div class="mt-3 whitespace-pre-wrap text-base text-base-content/70"><%= @space.availability %></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="card bg-base-100 shadow-md sticky top-4">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4"><%= t(".care_home") %></h2>

          <div class="mb-6">
            <h3 class="font-semibold text-lg mb-2"><%= link_to care_home.name, care_home, class: "link link-hover" %></h3>
            <div class="text-sm text-base-content/70 mb-3">
              <% if details&.coordinates? %>
                <%= link_to details.osm_map_url, target: "_blank", rel: "noopener noreferrer",
                      class: "inline-flex w-full min-w-0 items-start gap-2 whitespace-normal break-words link link-hover" do %>
                  <%= pin_icon %><span class="min-w-0 break-words"><%= address_label %></span>
                <% end %>
              <% else %>
                <div class="inline-flex w-full min-w-0 items-start gap-2 whitespace-normal break-words">
                  <%= pin_icon %><span class="min-w-0 break-words"><%= address_label %></span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="divider my-4"></div>

          <div class="flex flex-col gap-3">
            <%= link_to spaces_path, class: "btn btn-primary btn-outline btn-block" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
              </svg>
              <%= t(".back_to_list") %>
            <% end %>

            <%= link_to new_care_home_hosting_request_path(care_home, space_id: @space.id), class: "btn btn-primary btn-block" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
              </svg>
              <%= t(".contact") %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-md mb-8">
    <div class="card-body">
      <h2 class="card-title text-2xl mb-4"><%= t(".location") %></h2>
      <% if details&.coordinates? %>
        <div class="rounded-box overflow-hidden border border-base-300">
          <iframe title="<%= t(".map_title", care_home: care_home.name) %>" src="<%= details.osm_embed_url %>"
                  class="w-full h-80" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="card-actions justify-end mt-4">
          <%= link_to t(".larger_map"), details.osm_map_url, target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline btn-sm" %>
        </div>
      <% else %>
        <div class="alert alert-info"><span><%= t(".no_coordinates") %></span></div>
      <% end %>
    </div>
  </div>

  <% if @images.size > 1 %>
    <div class="card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl mb-4"><%= t(".gallery") %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @images.each do |space_image| %>
            <div class="relative overflow-hidden rounded-lg bg-base-200 h-48 cursor-pointer hover:opacity-80 transition-opacity">
              <%= image_tag space_image.image.variant(:card), alt: space_image.alt_text, class: "w-full h-full object-cover", loading: "lazy" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
