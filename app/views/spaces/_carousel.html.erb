<%# Image carousel for a space. Locals: images, size (:small on the list, :large on the detail page) %>
<% height = size == :large ? "h-96" : "h-48" %>
<% if images.any? %>
  <div class="relative w-full overflow-hidden bg-gray-100 group <%= height %>" data-controller="carousel">
    <div class="carousel carousel-center w-full h-full scroll-smooth" data-carousel-target="track" data-action="scroll->carousel#sync">
      <% images.each do |space_image| %>
        <div class="carousel-item relative w-full h-full min-w-full" data-carousel-target="slide">
          <%= image_tag space_image.image, alt: space_image.alt_text, class: "w-full h-full object-cover" %>
        </div>
      <% end %>
    </div>

    <% if images.size > 1 %>
      <button type="button" class="absolute left-3 top-1/2 -translate-y-1/2 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-black/30 hover:bg-black/50 rounded-full p-1.5 cursor-pointer"
              data-action="carousel#previous" aria-label="Image précédente">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="white" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>
      <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-black/30 hover:bg-black/50 rounded-full p-1.5 cursor-pointer"
              data-action="carousel#next" aria-label="Image suivante">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="white" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5L15.75 12l-7.5 7.5" />
        </svg>
      </button>

      <div class="absolute bottom-3 left-2 right-2 flex gap-2 justify-center z-20">
        <% images.each_with_index do |_, index| %>
          <button type="button" class="h-2 rounded-full transition-all duration-200 <%= index.zero? ? "bg-primary w-6" : "bg-base-100/60 hover:bg-base-100/80 w-2" %>"
                  data-carousel-target="dot" data-action="carousel#goTo" data-carousel-index-param="<%= index %>"
                  aria-label="Aller à l'image <%= index + 1 %>"></button>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="relative w-full overflow-hidden bg-gray-100 flex items-center justify-center <%= height %>">
    <svg class="absolute w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
    </svg>
  </div>
<% end %>
