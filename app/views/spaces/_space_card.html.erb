<%# Hovering a card highlights its marker on the map next to the list. %>
<div class="card bg-base-200 hover:shadow-lg transition-shadow overflow-hidden"
     data-action="mouseenter->directory-map#highlight mouseleave->directory-map#unhighlight" data-directory-map-id-param="<%= space.id %>">
  <%= render "carousel", images: space.images, size: :small %>
  <div class="absolute top-2 left-2 z-20 max-w-[calc(100%-16px)] pr-2">
    <span class="badge badge-neutral badge-xs rounded-sm! inline-block max-w-full">
      <span class="truncate text-left text-xs"><%= space.care_home.name %></span>
    </span>
  </div>
  <div class="card-body">
    <h2 class="font-bold text-base"><%= space.name %> (<%= space.care_home.name %>)</h2>
    <% if space.distance_km %>
      <div class="badge badge-outline badge-sm rounded-sm!"><%= t(".distance", distance: number_with_precision(space.distance_km, precision: 1)) %></div>
    <% end %>

    <p class="text-sm text-base-content/70">
      <span class="block font-semibold mb-1"><%= t(".name") %></span>
      <%= space.name %>
    </p>
    <% if search.slots_unknown?(space) %>
      <div class="badge badge-ghost badge-sm rounded-sm!"><%= t(".slots_unknown") %></div>
    <% end %>
    <% if space.recurring_availabilities.any? %>
      <p class="mt-3 text-sm text-base-content/70">
        <span class="block font-semibold mb-1 text-base-content"><%= t(".recurring_availability") %></span>
        <%= t(".weekly_slots", count: space.recurring_availabilities.size) %>
      </p>
    <% end %>

    <div class="card-actions justify-center pt-4">
      <%= link_to space_path(space), class: "btn btn-outline btn-sm gap-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672ZM12 2.25V4.5m5.834.166-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243-1.59-1.59" />
        </svg>
        <%= t(".more") %>
      <% end %>
    </div>
  </div>
</div>
