<% content_for :title, t("guides.title") %>
<%= render "header" %>

<div class="mx-auto max-w-4xl">
  <p class="text-sm font-semibold uppercase tracking-wide text-secondary"><%= t(".eyebrow") %></p>
  <h1 class="mt-2 text-4xl font-bold"><%= t("guides.title") %></h1>
  <p class="mt-4 text-lg text-base-content/70"><%= t(".intro") %></p>

  <%# Everyone sees the boxes; without access, opening one asks for an email. %>
  <div class="mt-10 space-y-10">
    <% @sections.each do |section, pages| %>
      <section>
        <h2 class="mb-4 text-2xl font-bold"><%= section %></h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <% pages.each do |page| %>
            <%= link_to guide_access? ? guide_page_path(page) : guide_path(page: page.slug),
                  class: "card border border-base-300 bg-base-100 shadow-sm transition hover:border-secondary" do %>
              <div class="card-body flex-row items-center gap-3 p-5">
                <span class="text-2xl" aria-hidden="true"><%= page.icon %></span>
                <span class="flex-1 font-semibold"><%= page.title %></span>
                <% unless guide_access? %>
                  <span class="badge badge-ghost badge-sm"><%= t(".locked") %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <% unless guide_access? %>
    <div class="card mt-10 border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body gap-4 p-6 sm:p-8">
        <h2 class="card-title text-2xl"><%= t(".request.heading") %></h2>
        <p class="text-base-content/70"><%= t(".request.intro") %></p>
        <%= render "access_form", page: nil %>
      </div>
    </div>

    <% if @requested_page %>
      <%# Open on load, so it works without JavaScript; the close button is a dialog form. %>
      <dialog class="modal modal-open" open aria-labelledby="guide-access-title">
        <div class="modal-box">
          <h2 id="guide-access-title" class="text-xl font-bold"><%= t(".dialog.heading", page: @requested_page.title) %></h2>
          <p class="mt-2 mb-4 text-base-content/70"><%= t(".dialog.intro") %></p>
          <%= render "access_form", page: @requested_page %>
          <div class="modal-action">
            <%= link_to t(".dialog.close"), guide_path, class: "btn btn-ghost" %>
          </div>
        </div>
        <%= link_to "", guide_path, class: "modal-backdrop", "aria-label": t(".dialog.close") %>
      </dialog>
    <% end %>
  <% end %>
</div>
