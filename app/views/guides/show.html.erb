<% content_for :title, t(".title", page: @page.title) %>
<%= render "header" %>

<div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
  <nav class="order-last lg:order-first" aria-label="<%= t(".contents") %>">
    <%= link_to t(".back"), guide_path, class: "link link-hover text-sm font-medium" %>
    <% @sections.each do |section, pages| %>
      <h2 class="mt-6 mb-2 text-sm font-semibold uppercase tracking-wide text-base-content/70"><%= section %></h2>
      <ul class="menu menu-sm w-full p-0">
        <% pages.each do |page| %>
          <li><%= link_to "#{page.icon} #{page.title}", guide_page_path(page), class: ("menu-active" if page == @page) %></li>
        <% end %>
      </ul>
    <% end %>
  </nav>

  <article class="min-w-0">
    <% if @page.cover.attached? %>
      <%= image_tag guide_image_path(@page.cover.attachment.id), alt: "", class: "mb-8 h-56 w-full rounded-box object-cover" %>
    <% end %>
    <p class="text-sm font-semibold uppercase tracking-wide text-secondary"><%= @page.section %></p>
    <h1 class="mt-2 mb-8 text-4xl font-bold"><span aria-hidden="true"><%= @page.icon %></span> <%= @page.title %></h1>
    <div class="guide-content prose max-w-none">
      <%= guide_body(@page) %>
    </div>
  </article>
</div>
