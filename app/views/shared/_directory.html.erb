<%# Layout for a directory: its cards (the block) beside a map of their markers,
    or one of the two on phones (view_mode). Cards highlight their marker with
    data-action="mouseenter->directory-map#highlight mouseleave->directory-map#unhighlight"
    and data-directory-map-id-param. %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]" data-controller="directory-map"
     data-directory-map-markers-value="<%= markers.to_json %>" data-directory-map-messages-value="<%= t(".popup").to_json %>">
  <div class="<%= "hidden lg:block" if view_mode == "map" %>">
    <%= yield %>
  </div>
  <div class="<%= "hidden lg:block" if view_mode == "list" %>">
    <div class="directory-map h-[70vh] overflow-hidden rounded-box border border-base-300 lg:sticky lg:top-4 lg:h-[calc(100vh-2rem)]"
         data-directory-map-target="map"></div>
    <p class="mt-2 hidden text-sm text-base-content/70" data-directory-map-target="noMarkers"><%= t(".no_markers") %></p>
  </div>
</div>
