<%# Live checklist of the password rules, inside a password-rules controller. %>
<ul class="mt-3 space-y-1 text-sm" aria-live="polite">
  <% %w[length numeric match].each do |rule| %>
    <li data-password-rules-target="rule" data-rule="<%= rule %>"><span aria-hidden="true">○</span> <%= t(".#{rule}") %></li>
  <% end %>
</ul>
