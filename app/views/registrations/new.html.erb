<% content_for :title, t(".title") %>

<div class="mx-auto max-w-4xl">
  <div class="mb-10 max-w-2xl">
    <%= link_to t("back_home"), root_path, class: "link link-hover text-sm font-medium" %>
    <p class="mt-8 text-sm font-semibold uppercase tracking-wide text-primary"><%= t("sessions.new.eyebrow") %></p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight"><%= t(".heading") %></h1>
    <p class="mt-4 text-lg text-base-content/70"><%= t(".intro") %></p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <%= form_with model: @registration, url: registrations_path, class: "card border border-base-300 bg-base-100 shadow-sm" do |form| %>
      <div class="card-body gap-8 p-6 sm:p-8">
        <fieldset class="fieldset">
          <legend class="fieldset-legend text-lg"><%= t(".establishment.legend") %></legend>
          <p class="label mb-3"><%= t(".establishment.help") %></p>
          <div class="grid gap-6 sm:grid-cols-2">
            <% [:establishment_name, :establishment_address, :contact_name].each do |field| %>
              <label class="form-control w-full <%= "sm:col-span-2" if field == :establishment_address %>">
                <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(field) %></span>
                <%= form.text_field field, required: true, class: "input input-md w-full" %>
                <%= render "shared/field_errors", model: @registration, field: %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="divider my-0"></div>

        <fieldset class="fieldset" data-controller="password-rules">
          <legend class="fieldset-legend text-lg"><%= t(".account.legend") %></legend>
          <p class="label mb-3"><%= t(".account.help") %></p>
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="form-control w-full sm:col-span-2">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:email_address) %></span>
              <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input input-md w-full" %>
              <span class="label-text-alt mt-2"><%= t(".account.email_help") %></span>
              <%= render "shared/field_errors", model: @registration, field: :email_address %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:password) %></span>
              <%= render "shared/password_field", form:, field: :password, autocomplete: "new-password" %>
              <span class="label-text-alt mt-2"><%= t(".account.password_help") %></span>
              <%= render "shared/password_rules" %>
              <%= render "shared/field_errors", model: @registration, field: :password %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:password_confirmation) %></span>
              <%= render "shared/password_field", form:, field: :password_confirmation, autocomplete: "new-password" %>
              <%= render "shared/field_errors", model: @registration, field: :password_confirmation %>
            </label>
          </div>
        </fieldset>

        <div class="divider my-0"></div>

        <fieldset class="fieldset">
          <legend class="fieldset-legend text-lg"><%= t(".modules.legend") %></legend>
          <p class="label mb-3"><%= t(".modules.help") %></p>
          <% @registration.errors[:modules].each do |message| %>
            <p class="mb-3 text-sm text-error"><%= message %></p>
          <% end %>
          <div class="grid gap-3 sm:grid-cols-2">
            <%= form.collection_check_boxes :modules, EhpadRegistration::MODULES, :itself, ->(mod) { t(".modules.#{mod}.label") } do |choice| %>
              <label class="flex cursor-pointer items-start gap-3 rounded-box border border-base-300 p-4 transition hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <%= choice.check_box class: "checkbox checkbox-primary mt-1" %>
                <span>
                  <span class="block font-semibold"><%= choice.text %></span>
                  <span class="mt-1 block text-sm text-base-content/60"><%= t(".modules.#{choice.value}.description") %></span>
                </span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="card-actions items-center justify-end gap-3">
          <%= link_to t(".cancel"), root_path, class: "btn btn-ghost" %>
          <button class="btn btn-primary" type="submit"><%= t(".submit") %></button>
        </div>
      </div>
    <% end %>

    <aside class="h-fit rounded-box bg-base-200 p-5">
      <h2 class="font-semibold"><%= t(".next_steps.heading") %></h2>
      <ul class="mt-4 space-y-4 text-sm text-base-content/70">
        <% t(".next_steps.items").each.with_index(1) do |item, number| %>
          <li class="flex gap-3"><span class="badge badge-primary badge-sm mt-0.5"><%= number %></span><span><%= item %></span></li>
        <% end %>
      </ul>
    </aside>
  </div>
</div>
