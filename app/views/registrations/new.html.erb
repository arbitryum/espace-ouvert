<% content_for :title, t(".title") %>

<div class="mx-auto max-w-4xl">
  <div class="mb-10 max-w-2xl">
    <%= link_to t("back_home"), root_path, class: "link link-hover text-sm font-medium" %>
    <p class="mt-8 text-sm font-semibold uppercase tracking-wide text-primary"><%= t("sessions.new.eyebrow") %></p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight"><%= t(".heading") %></h1>
    <p class="mt-4 text-lg text-base-content/70"><%= t(".intro") %></p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <%= form_with model: @registration, url: registrations_path, multipart: true, class: "card min-w-0 border border-base-300 bg-base-100 shadow-sm",
          data: { controller: "registration-form" } do |form| %>
      <div class="card-body gap-8 p-6 sm:p-8">
        <fieldset class="fieldset">
          <legend class="fieldset-legend text-lg"><%= t(".establishment.legend") %></legend>
          <p class="label mb-3 whitespace-normal"><%= t(".establishment.help") %></p>
          <div class="grid items-end gap-6 sm:grid-cols-2" data-controller="address-autocomplete"
               data-address-autocomplete-url-value="<%= address_suggestions_path %>"
               data-address-autocomplete-messages-value="<%= t(".address").to_json %>">
            <label class="form-control w-full sm:col-span-2">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:establishment_name) %></span>
              <%= form.text_field :establishment_name, required: true, autocomplete: "organization", class: "input input-md w-full" %>
              <%= render "shared/field_errors", model: @registration, field: :establishment_name %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:legal_status) %></span>
              <%= form.select :legal_status, CareHome::LEGAL_STATUSES.map { |status| [CareHome.human_enum_name(:legal_status, status), status] },
                    { include_blank: true }, required: true, class: "select w-full" %>
              <%= render "shared/field_errors", model: @registration, field: :legal_status %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:group_name) %></span>
              <%= form.text_field :group_name, class: "input input-md w-full" %>
              <%= render "shared/field_errors", model: @registration, field: :group_name %>
            </label>
            <%# The browser's own autofill list would cover the suggestions. %>
            <div class="relative sm:col-span-2">
              <label class="form-control w-full">
                <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:street) %></span>
                <span class="label-text-alt mb-2 block text-base-content/70"><%= t(".address.hint") %></span>
                <%= form.text_field :street, required: true, autocomplete: "off", class: "input input-md w-full",
                      role: "combobox", aria: { autocomplete: "list", expanded: false, controls: "registration-address-suggestions" },
                      data: { address_autocomplete_target: "street",
                              action: "input->address-autocomplete#search keydown->address-autocomplete#navigate blur->address-autocomplete#close" } %>
                <%= render "shared/field_errors", model: @registration, field: :street %>
              </label>
              <ul id="registration-address-suggestions" role="listbox" aria-label="<%= t(".address.listbox") %>" hidden
                  class="absolute z-10 mt-1 max-h-72 w-full overflow-auto rounded-box border border-base-300 bg-base-100 shadow-lg"
                  data-address-autocomplete-target="listbox"></ul>
              <p class="sr-only" aria-live="polite" data-address-autocomplete-target="status"></p>
            </div>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:postal_code) %></span>
              <%= form.text_field :postal_code, required: true, inputmode: "numeric", pattern: "[0-9]{5}", maxlength: 5, autocomplete: "postal-code", class: "input input-md w-full",
                    data: { address_autocomplete_target: "postalCode" } %>
              <%= render "shared/field_errors", model: @registration, field: :postal_code %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:city) %></span>
              <%= form.text_field :city, required: true, autocomplete: "address-level2", class: "input input-md w-full",
                    data: { address_autocomplete_target: "city" } %>
              <%= render "shared/field_errors", model: @registration, field: :city %>
            </label>
          </div>
        </fieldset>

        <div class="divider my-0"></div>

        <fieldset class="fieldset" data-controller="password-rules">
          <legend class="fieldset-legend text-lg"><%= t(".account.legend") %></legend>
          <p class="label mb-3 whitespace-normal"><%= t(".account.help") %></p>
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:contact_name) %></span>
              <%= form.text_field :contact_name, required: true, autocomplete: "name", class: "input input-md w-full" %>
              <%= render "shared/field_errors", model: @registration, field: :contact_name %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:email_address) %></span>
              <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input input-md w-full" %>
              <span class="label-text-alt mt-2"><%= t(".account.email_help") %></span>
              <%= render "shared/field_errors", model: @registration, field: :email_address %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:password) %></span>
              <%= render "shared/password_field", form:, field: :password, autocomplete: "new-password" %>
              <span class="label-text-alt mt-2"><%= t(".account.password_help") %></span>
              <%= render "shared/password_rules" %>
              <%= render "shared/field_errors", model: @registration, field: :password %>
            </label>
            <label class="form-control w-full">
              <span class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:password_confirmation) %></span>
              <%= render "shared/password_field", form:, field: :password_confirmation, autocomplete: "new-password" %>
              <%= render "shared/field_errors", model: @registration, field: :password_confirmation %>
            </label>
          </div>
        </fieldset>

        <div class="divider my-0"></div>

        <fieldset class="fieldset">
          <legend class="fieldset-legend text-lg"><%= t(".modules.legend") %></legend>
          <p class="label mb-3 whitespace-normal"><%= t(".modules.help") %></p>
          <% @registration.errors[:modules].each do |message| %>
            <p class="mb-3 text-sm text-error"><%= message %></p>
          <% end %>
          <div class="grid gap-3 sm:grid-cols-2">
            <%= form.collection_check_boxes :modules, EhpadRegistration::MODULES, :itself, ->(mod) { t(".modules.#{mod}.label") } do |choice| %>
              <label class="flex cursor-pointer items-start gap-3 rounded-box border border-base-300 p-4 transition hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <%= choice.check_box class: "checkbox checkbox-primary mt-1", data: { registration_form_target: "module", action: "registration-form#update" } %>
                <span>
                  <span class="block font-semibold"><%= choice.text %></span>
                  <span class="mt-1 block text-sm text-base-content/70"><%= t(".modules.#{choice.value}.description") %></span>
                </span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <%# Shown when its module is ticked; hidden sections' fields are disabled, so not sent. %>
        <fieldset class="fieldset gap-4" data-module="coworking" data-registration-form-target="section">
          <legend class="fieldset-legend text-lg"><%= t(".coworking.legend") %></legend>
          <div>
            <p class="label-text mb-2 font-medium"><%= EhpadRegistration.human_attribute_name(:coworking_space) %></p>
            <div class="flex gap-6">
              <% %w[yes no].each do |answer| %>
                <label class="label cursor-pointer gap-2">
                  <%= form.radio_button :coworking_space, answer, class: "radio radio-primary", data: { action: "registration-form#update" } %>
                  <span><%= t(".coworking.#{answer}") %></span>
                </label>
              <% end %>
            </div>
            <%= render "shared/field_errors", model: @registration, field: :coworking_space, full: false %>
          </div>
          <div class="alert alert-success" data-answer="yes" hidden><span><%= t(".coworking.yes_message") %></span></div>
          <div class="alert alert-warning" data-answer="no" hidden><span><%= t(".coworking.no_message") %></span></div>
          <label class="form-control w-full">
            <span class="label-text block font-medium"><%= EhpadRegistration.human_attribute_name(:coworking_photos) %></span>
            <span class="label-text-alt mb-2 block text-base-content/60"><%= t(".photos_hint", count: EhpadRegistration::MAX_PHOTOS) %></span>
            <%= form.file_field :coworking_photos, multiple: true, accept: EhpadRegistration::PHOTO_TYPES.join(","), class: "file-input w-full" %>
            <%= render "shared/field_errors", model: @registration, field: :coworking_photos, full: false %>
          </label>
        </fieldset>

        <fieldset class="fieldset gap-4" data-module="spaces" data-registration-form-target="section">
          <legend class="fieldset-legend text-lg"><%= t(".spaces.legend") %></legend>
          <p class="text-base-content/70"><%= t(".spaces.intro") %></p>
          <% @registration.errors[:spaces].each do |message| %>
            <p class="text-sm text-error"><%= message %></p>
          <% end %>
          <div class="space-y-4" data-registration-form-target="spaces">
            <% inputs = @registration.spaces.presence || [EhpadRegistration::SpaceInput.new] %>
            <% inputs.each_with_index do |input, index| %>
              <%= render "space_fields", input:, index: %>
            <% end %>
          </div>
          <template data-registration-form-target="template">
            <%= render "space_fields", input: EhpadRegistration::SpaceInput.new, index: "__INDEX__" %>
          </template>
          <button type="button" class="btn btn-outline btn-sm w-fit" data-action="registration-form#addSpace"><%= t(".spaces.add") %></button>
        </fieldset>

        <% if @registration.errors.any? %>
          <p class="text-sm text-base-content/60"><%= t(".photos_again") %></p>
        <% end %>

        <div class="card-actions items-center justify-end gap-3">
          <%= link_to t(".cancel"), root_path, class: "btn btn-ghost" %>
          <button class="btn btn-primary" type="submit"><%= t(".submit") %></button>
        </div>
      </div>
    <% end %>

    <aside class="h-fit rounded-box bg-base-200 p-5">
      <h2 class="font-semibold"><%= t(".next_steps.heading") %></h2>
      <ul class="mt-4 space-y-4 text-sm text-base-content/70">
        <% t(".next_steps.items").each.with_index(1) do |item, number| %>
          <li class="flex gap-3"><span class="badge badge-primary badge-sm mt-0.5"><%= number %></span><span><%= item %></span></li>
        <% end %>
      </ul>
    </aside>
  </div>
</div>
