<% content_for :title, t(".title") %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-6">
  <div class="max-w-2xl">
    <%= link_to t(".back"), coworking_path, class: "link link-hover text-sm font-medium" %>
    <p class="mt-8 text-sm font-semibold uppercase tracking-wide text-secondary"><%= t(".eyebrow") %></p>
    <h1 class="mt-2 text-4xl font-bold"><%= t(".heading") %></h1>
    <p class="mt-4 text-lg text-base-content/70"><%= t(".intro") %></p>
  </div>
  <%= link_to t(".register"), new_registration_path, class: "btn btn-outline btn-secondary" %>
</div>

<% if @care_homes.any? %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-base-content/70"><%= t(".count", count: @care_homes.size) %></p>
    <%= render "shared/view_mode_toggle", view_mode: @view_mode %>
  </div>

  <%= render layout: "shared/directory", locals: { markers: coworking_care_home_markers(@care_homes), view_mode: @view_mode } do %>
    <div class="grid gap-6 sm:grid-cols-2">
      <% @care_homes.each do |care_home| %>
        <% photo = care_home.coworking_photos.first %>
        <% tag = coworking_tag(care_home) %>
        <article class="card overflow-hidden border border-base-300 bg-base-100 shadow-sm transition-shadow hover:shadow-lg"
                 data-action="mouseenter->directory-map#highlight mouseleave->directory-map#unhighlight" data-directory-map-id-param="<%= care_home.id %>">
          <% if photo %>
            <figure class="h-40 bg-base-200"><%= image_tag photo.variant(:card), alt: "", loading: "lazy", class: "h-full w-full object-cover" %></figure>
          <% end %>
          <div class="card-body gap-2">
            <% if tag %>
              <div class="badge <%= care_home.coworking_full? ? "badge-neutral" : "badge-secondary" %> badge-sm"><%= tag %></div>
            <% end %>
            <h2 class="card-title"><%= link_to care_home.name, care_home, class: "link link-hover" %></h2>
            <p class="text-sm text-base-content/70"><%= care_home.address_details&.concise_label.presence || care_home.address %></p>
            <% if care_home.group_name.present? %>
              <p class="text-sm text-base-content/70"><%= care_home.group_name %></p>
            <% end %>
            <div class="card-actions mt-2 justify-end">
              <%= link_to t("coworking.care_homes.index.contact"), new_care_home_hosting_request_path(care_home, kind: "coworking"), class: "btn btn-sm btn-secondary" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="alert alert-info"><span><%= t(".empty") %></span></div>
<% end %>
