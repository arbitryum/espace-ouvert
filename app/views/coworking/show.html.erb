<% content_for :title, t(".title") %>

<% content_for :header do %>
  <div class="bg-base-200">
    <div class="mx-auto flex max-w-6xl px-4 py-4">
      <%= render "shared/home_button" %>
    </div>
  </div>
<% end %>

<section class="hero min-h-[28rem] rounded-box bg-secondary text-secondary-content">
  <div class="hero-content max-w-4xl text-center">
    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide"><%= t(".title") %></p>
      <h1 class="text-4xl font-bold md:text-5xl"><%= t(".heading") %></h1>
      <p class="py-6 text-lg"><%= t(".intro") %></p>
      <div class="flex flex-wrap justify-center gap-3">
        <%= link_to t(".directory_cta"), coworking_projects_path, class: "btn btn-primary" %>
        <%= link_to t(".guide_cta"), guide_path, class: "btn btn-outline" %>
        <a class="btn btn-outline" href="#inscription"><%= t(".register_cta") %></a>
      </div>
    </div>
  </div>
</section>

<section class="py-12" id="annuaire">
  <div class="mb-6">
    <h2 class="text-3xl font-bold text-primary"><%= t(".directory.heading") %></h2>
    <p class="mt-2 text-base-content/70"><%= t(".directory.intro") %></p>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    <% t(".directory.features").each do |feature| %>
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title"><%= feature[:title] %></h3>
          <p><%= feature[:text] %></p>
        </div>
      </div>
    <% end %>
  </div>
</section>

<section class="rounded-box bg-base-200 p-8" id="inscription">
  <h2 class="text-2xl font-bold"><%= t(".registration.heading") %></h2>
  <p class="mt-2 max-w-2xl text-base-content/70"><%= t(".registration.text") %></p>
  <button class="btn btn-primary mt-5" type="button" disabled><%= t(".register_cta") %></button>
</section>
