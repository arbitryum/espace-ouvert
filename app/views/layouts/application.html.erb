<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for?(:title) ? t(".title_html", page: yield(:title)) : t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= t("app_name") %>">
    <%# Required by the OpenStreetMap tile policy: send the origin as referrer on tile requests. %>
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# The Softr site's icon. %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-100">
    <%= render "shared/account_bar" if authenticated? %>
    <div id="header"><%= yield :header %></div>

    <div id="content" class="max-w-6xl mx-auto px-4 py-8">
      <% flash.each do |type, message| %>
        <div class="alert <%= type == "notice" ? "alert-success" : "alert-warning" %> mb-6" role="alert">
          <span><%= message %></span>
        </div>
      <% end %>
      <%= yield %>
    </div>

    <%# Like the Softr site's: logo, who runs it, and its partners' logos. %>
    <footer id="footer" class="bg-base-200 px-4 py-10 text-center text-sm text-base-content/70">
      <p class="pb-8"><%= t(".contact", email: "sab@arbitryum.fr") %></p>
      <%= image_tag "logo.png", alt: t("app_name"), width: 1000, height: 250, class: "mx-auto h-auto w-56" %>
      <p class="mt-4 italic"><%= t(".credits") %></p>
      <%= image_tag "footer_logos.png", alt: t(".partners"), width: 1000, height: 250, class: "mx-auto mt-2 h-auto w-full max-w-md" %>
      <p class="mt-6 text-xs"><%= t(".copyright_html", year: Date.current.year) %></p>
    </footer>
  </body>
</html>
