<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for?(:title) ? t(".title", page: yield(:title)) : t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= t("app_name") %>">
    <%# Required by the OpenStreetMap tile policy: send the origin as referrer on tile requests. %>
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-100">
    <div id="header"><%= yield :header %></div>

    <div id="content" class="max-w-6xl mx-auto px-4 py-8">
      <% flash.each do |type, message| %>
        <div class="alert <%= type == "notice" ? "alert-success" : "alert-warning" %> mb-6" role="alert">
          <span><%= message %></span>
        </div>
      <% end %>
      <%= yield %>
    </div>

    <footer id="footer" class="bg-gray-100 py-4 text-center text-sm text-gray-600">
      <p class="pb-8"><%= t(".contact", email: "mathilde.boulet@arbitryum.fr") %></p>
      <%= t(".copyright_html", year: Date.current.year) %>
    </footer>
  </body>
</html>
