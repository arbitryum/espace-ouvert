<% content_for :title, "Espaces Ouverts" %>

<section class="hero rounded-box bg-base-200 py-16">
  <div class="hero-content max-w-3xl text-center">
    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">Espaces Ouverts</p>
      <h1 class="text-4xl font-bold md:text-5xl">Des lieux qui créent du lien</h1>
      <p class="py-6 text-lg text-base-content/70">
        Choisissez votre parcours pour découvrir les espaces et les initiatives
        qui rapprochent les EHPAD de leur quartier.
      </p>
    </div>
  </div>
</section>

<section class="py-12" aria-labelledby="products-title">
  <div class="mb-8 text-center">
    <h2 id="products-title" class="text-3xl font-bold">Que recherchez-vous ?</h2>
    <p class="mt-2 text-base-content/70">Explorez l'un de nos deux dispositifs.</p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <article class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="mb-2 badge badge-primary">Associations</div>
        <h3 class="card-title text-2xl">Espace Ouvert</h3>
        <p>
          Trouvez un espace disponible en EHPAD pour organiser des activités
          associatives ouvertes aux habitants du quartier.
        </p>
        <div class="card-actions mt-4">
          <%= link_to "Découvrir les espaces", spaces_path, class: "btn btn-primary" %>
        </div>
      </div>
    </article>

    <article class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="mb-2 badge badge-secondary">Coworking</div>
        <h3 class="card-title text-2xl">Coworking en EHPAD</h3>
        <p>
          Découvrez les établissements qui accueillent des équipes de coworking
          et préparez votre projet avec les bonnes ressources.
        </p>
        <div class="card-actions mt-4">
          <%= link_to "Découvrir le coworking", coworking_path, class: "btn btn-secondary" %>
        </div>
      </div>
    </article>
  </div>
</section>
