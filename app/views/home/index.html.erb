<section class="hero rounded-box bg-base-200 py-16">
  <div class="hero-content max-w-3xl text-center">
    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary"><%= t(".eyebrow") %></p>
      <h1 class="text-4xl font-bold text-primary md:text-5xl"><%= t(".heading") %></h1>
      <p class="py-6 text-lg text-base-content/70"><%= t(".intro") %></p>
    </div>
  </div>
</section>

<section class="py-12" aria-labelledby="products-title">
  <div class="mb-8 text-center">
    <h2 id="products-title" class="text-3xl font-bold"><%= t(".products_heading") %></h2>
    <p class="mt-2 text-base-content/70"><%= t(".products_intro") %></p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <% [[:spaces, spaces_path, "primary"], [:coworking, coworking_path, "secondary"]].each do |product, path, color| %>
      <article class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="mb-2 badge badge-<%= color %>"><%= t(".#{product}.badge") %></div>
          <h3 class="card-title text-2xl"><%= t(".#{product}.title") %></h3>
          <p><%= t(".#{product}.text") %></p>
          <div class="card-actions mt-4">
            <%= link_to t(".#{product}.cta"), path, class: "btn btn-#{color} h-auto min-h-(--size) shrink py-2 text-wrap" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
