# Production (Scalingo) environment variables.
# DATABASE_URL is provided by the Scalingo PostgreSQL addon.
SECRET_KEY_BASE=          # bin/rails secret
RAILS_LOG_LEVEL=info

# Scaleway Object Storage (Active Storage "scaleway" service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=espaces-ouverts-production
AWS_S3_REGION_NAME=fr-par
AWS_S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud

# Emails (guide access links)
MAILER_FROM="Espaces Ouverts <ne-pas-repondre@example.com>"
APP_HOST=espaces-ouverts-production.osc-fr1.scalingo.io
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional
GEOCODING_TIMEOUT_SECONDS=10
